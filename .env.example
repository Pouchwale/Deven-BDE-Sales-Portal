# =============================================================================
# BDE & Sales Portal - backend configuration
#
# Copy to backend/.env for development. On a production server put these in
# the service's own environment file (readable only by the service account).
# Placeholders only - never commit a real value to this file.
#
# Production refuses to start (with a list of every problem, by setting name)
# unless the rules marked [PROD] below are met.
# =============================================================================

# ------------------------------------------------------------- environment
# development | test | e2e | production   ("dev" is accepted as development)
#   e2e = a disposable server the end-to-end runners are allowed to drive.
ENV=development

APP_NAME=BDE & Sales Portal
TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- database
# REQUIRED in every environment - there is no default.
# [PROD] must be PostgreSQL. SQLite is accepted only outside production.
#
# Create a dedicated least-privilege login that owns its own database rather
# than connecting as the `postgres` superuser:
#   CREATE ROLE bde_portal LOGIN PASSWORD '...';
#   CREATE DATABASE bde_portal OWNER bde_portal;
#   CREATE DATABASE bde_portal_test OWNER bde_portal;
# then: python -m app.db.migrate upgrade
#
# The superuser password belongs in the DBA's password manager / pgpass file,
# never in this file or any environment the portal process can read.
# URL-encode the password if it contains @ : / or #.
DATABASE_URL=postgresql+psycopg2://bde_portal:CHANGE_ME@localhost:5432/bde_portal

# SQLite for a quick throwaway run (development only):
#DATABASE_URL=sqlite:///./bde_portal.db

# Connection pool (PostgreSQL only).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Server-side cap per SQL statement, ms. 0 disables. Migrations never use it.
DB_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------ secrets/auth
# Signs CSRF tokens.
# [PROD] required, at least 32 characters, never a published placeholder.
# Blank outside production = a random key per process (sessions' CSRF tokens
# then do not survive a restart). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---------------------------------------------------------------- sessions
# Server-side sessions carried in an HttpOnly cookie, plus a double-submit
# CSRF cookie echoed back in the X-CSRF-Token header.
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_COOKIE_NAME=bde_session
CSRF_COOKIE_NAME=bde_csrf
# [PROD] true (cookies only over HTTPS). Development over http://localhost: false.
COOKIE_SECURE=false
# lax | strict | none.  [PROD] lax or strict.
COOKIE_SAMESITE=lax
# Blank = host-only cookie (right for a same-origin deployment).
COOKIE_DOMAIN=

# Sign-in protection.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# Proxies whose X-Forwarded-For is believed, comma separated (IPs or CIDRs).
# Blank = trust none. Behind a reverse proxy on the same host: 127.0.0.1,::1
TRUSTED_PROXIES=

# Encrypts the copy of each password the Super Admin can reveal in User admin.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it secret. Blank = passwords cannot be revealed. Losing it only loses
# the reveal (sign-in never uses it); run app.seeds.backfill_password_vault
# after setting a new one for accounts still on a known password.
PASSWORD_VIEW_KEY=

# -------------------------------------------------------------------- CORS
# Exact origins, comma separated. The deployment is same-origin (the reverse
# proxy serves the frontend and /api together), so this is mostly defence in
# depth.  [PROD] non-empty, https only, no "*", no localhost/127.0.0.1.
CORS_ORIGINS=http://localhost:3000
# Optional pattern for LAN testing from a phone.  [PROD] must be blank.
CORS_ORIGIN_REGEX=

# ----------------------------------------------------------------- API docs
# /docs, /redoc, /openapi.json. Ignored (always off) in production.
DOCS_ENABLED=true

# ------------------------------------------------------------------ logging
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | text. Blank = json in production, text elsewhere.
LOG_FORMAT=
# Requests slower than this (ms) are logged at WARNING.
SLOW_REQUEST_MS=1500
# Run uvicorn with --no-access-log: the app writes its own access line (with
# the route template and request id, and without the query string).

# ------------------------------------------------------------------ SAP data
# Absolute path to the SAP workbook (.xlsm/.xlsx/.csv) customers are imported
# from. Blank imports every export in data/sap/ instead. In production a
# missing file is logged as an error but does not stop the portal.
SAP_DATA_FILE=
SAP_LINK_LEADS=true
SAP_AUTO_SYNC=true
SAP_SYNC_INTERVAL_SECONDS=30

# --------------------------------------------------------------- seed only
# DEVELOPMENT / TEST ONLY. Password given to every roster account the seed
# creates; required only when the seed has accounts to create.
# [PROD] must be unset - production never seeds accounts. Create the first
# administrator there with:
#   python -m app.seeds.bootstrap_admin --email you@example.com --name "Your Name"
SEED_PASSWORD=
# Force seeded accounts to replace the shared password at first sign-in.
SEED_FORCE_PASSWORD_CHANGE=true

# ----------------------------------------------------------- feedback alerts
FEEDBACK_RATING_SCALE_MAX=5
FEEDBACK_ALERT_THRESHOLD=3.0
FEEDBACK_ALERT_MIN_RESPONSES=5
FEEDBACK_ALERT_WINDOW_DAYS=30

# Google review CTA. Outbound link only - the portal never posts a review.
# Quote the value: the URL contains a # fragment.
GOOGLE_REVIEW_URL=

# -------------------------------------------------------- Google Form sync
# Shared secret the Apps Script signs deliveries with. Blank disables the
# webhook. Generate like SECRET_KEY (at least 32 characters).
GOOGLE_SYNC_SECRET=
# The Apps Script Web App URL for the pull fallback. Blank disables it.
GOOGLE_SYNC_URL=
GOOGLE_SYNC_MAX_SKEW_SECONDS=300
GOOGLE_SYNC_MAX_BODY_BYTES=65536
GOOGLE_SYNC_RATE_LIMIT=60
GOOGLE_SYNC_RATE_WINDOW_SECONDS=60
GOOGLE_SYNC_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------- assistant
# The in-portal AI assistant, served by Groq. It answers from the portal's own
# data, through the same authorization rules as the UI.
# Key from console.groq.com/keys. Blank disables the assistant (logged as a
# warning, never a startup failure).
GROQ_API_KEY=
# Both this AND a key are required before the assistant can answer.
CHAT_ENABLED=false
# llama-3.3-70b-versatile: 131k context and PARALLEL tool calling, which the
# loop relies on. Choose a model that calls tools reliably, not just a fast one.
GROQ_MODEL=llama-3.3-70b-versatile
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=2048
CHAT_HISTORY_MESSAGES=12
CHAT_MAX_TOOL_CALLS=6
CHAT_MAX_ROWS=25
CHAT_RATE_LIMIT_MESSAGES=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=300
CHAT_REQUEST_TIMEOUT_SECONDS=60

# =============================================================================
# Production example (values illustrative - generate your own secrets)
# =============================================================================
# ENV=production
# DATABASE_URL=postgresql+psycopg2://bde_portal:<url-encoded-password>@127.0.0.1:5432/bde_portal
# SECRET_KEY=<output of secrets.token_urlsafe(48)>
# CORS_ORIGINS=https://portal.example.com
# CORS_ORIGIN_REGEX=
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# TRUSTED_PROXIES=127.0.0.1,::1
# DOCS_ENABLED=false
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# SAP_DATA_FILE=D:\\portal-data\\sap\\export.xlsm
# SEED_PASSWORD=          (leave unset)
#
# Deploy order:  python -m app.db.migrate upgrade
#                python -m app.db.migrate check          (exits 1 if anything is pending)
#                python -m app.seeds.seed --allow-production   (teams/departments/settings only)
#                python -m app.seeds.bootstrap_admin --email ... --name ...   (first time only)

# ----------------------------------------------------------- super admin
# The Super Admin's sign-in, applied every time the backend starts: change
# the password here and restart. EMAIL and NAME are only used to create the
# account when no Super Admin exists yet (e.g. a fresh production database).
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
