# ---------------------------------------------------------------- database
# Dev default is SQLite. Production sets a Postgres URL and nothing else
# changes: the same SQL migrations render for both dialects.
#   SQLite      sqlite:///./bde_portal.db
#   PostgreSQL  postgresql+psycopg2://user:pass@host:5432/bde_portal
DATABASE_URL=sqlite:///./bde_portal.db

# ------------------------------------------------------------------- auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --------------------------------------------------------------- app
APP_NAME=BDE & Sales Portal
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ------------------------------------------------------------- SAP data
# The SAP workbook (.xlsm/.xlsx/.csv) customers are imported from.
# Blank imports every export in data/sap/ instead.
SAP_DATA_FILE=

# ------------------------------------------------------------ seed only
# Password given to every seeded account. Every seeded account is created
# with must_change_password = true, so this is a first-login credential only.
SEED_PASSWORD=ChangeMe@123
# Force seeded accounts to replace the shared password at first sign-in.
# Off for now so signing in is one click. Turn it on before real users get
# accounts, then run: python -m app.seeds.seed --reset-passwords
SEED_FORCE_PASSWORD_CHANGE=false

# --------------------------------------------------------- feedback alerts
FEEDBACK_RATING_SCALE_MAX=5
FEEDBACK_ALERT_THRESHOLD=3.0
FEEDBACK_ALERT_MIN_RESPONSES=5
FEEDBACK_ALERT_WINDOW_DAYS=30

# Google review CTA. Outbound link only - the portal never posts a review.
# Leave blank to use the configured link in app/seeds/roster.py; set it here
# to override per environment. Quote the value: the URL contains a # fragment.
GOOGLE_REVIEW_URL=

# --------------------------------------------------------------- assistant
# The in-portal AI assistant. It answers from the portal's own data, through
# the same authorization rules as the UI - see docs/CHATBOT_IMPLEMENTATION_PLAN.md.
#
# Served by Groq. Key from console.groq.com/keys - it starts "gsk_".
# Blank disables the assistant: the launcher still appears and the panel
# explains what is missing, but no message can be sent.
GROQ_API_KEY=

# Both this AND a key are required before the assistant can answer.
# With the flag on and no key, the launcher shows a setup panel instead.
CHAT_ENABLED=false

# llama-3.3-70b-versatile is the recommended default: a production Groq model
# with a 131k context and PARALLEL tool calling, which the loop relies on when
# a question needs two lookups at once. openai/gpt-oss-120b also works but
# calls tools one at a time. Do not pick purely on speed - the assistant is
# useless if it cannot call tools reliably.
GROQ_MODEL=llama-3.3-70b-versatile

# An assistant that quotes figures should not be inventive.
CHAT_TEMPERATURE=0.2

CHAT_MAX_TOKENS=2048
CHAT_HISTORY_MESSAGES=12
CHAT_MAX_TOOL_CALLS=6
CHAT_MAX_ROWS=25
CHAT_RATE_LIMIT_MESSAGES=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=300
CHAT_REQUEST_TIMEOUT_SECONDS=60
