# ---------------------------------------------------------------- secrets
# Never commit a real key. `.env.example` and `.env.local.example` are the
# templates that DO belong in the repo, so they are negated below.
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key

# -------------------------------------------------------------- databases
# The dev SQLite file, its WAL/SHM sidecars, and every timestamped backup.
# These hold real customer records - they are never repository content.
*.db
*.db-shm
*.db-wal
*.db.backup-*
*.sqlite
*.sqlite3

# ------------------------------------------------------------- SAP source
# The live SAP workbook and any copy of it. The portal reads it from the path
# in SAP_DATA_FILE; it is company data, not code.
*.xlsm
*.xlsx
*.xls
refresh-log.txt

# ----------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------ Node / Next
node_modules/
.next/
.next-*/
out/
build/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ----------------------------------------------------------- test output
# Screenshots are regenerated by `npm run e2e`; they are artefacts, not source.
frontend/tests/e2e/screenshots/
playwright-report/
test-results/
coverage/

# ------------------------------------------------------------------ logs
*.log

# --------------------------------------------------------- editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ------------------------------------------------------ deploy / backups
# Filled-in production env files, never the *.example templates. Backups are
# written outside the repo, but a stray dump must never be committed either.
deploy/**/*.env
!deploy/**/*.example
*.dump
*.dump.sha256
*.dump.partial
/backups/
/logs/
