# BDE & Sales Portal - backend production settings.
#
# Copy to backend\.env on the production host (the backend reads it on start)
# and replace every <placeholder>. Never commit the filled-in copy.
# With ENV=production the backend REFUSES TO START if the configuration is
# unsafe (SQLite, weak/default SECRET_KEY, non-https CORS origin, insecure
# cookies, SEED_PASSWORD set) and names each problem - never a value.

# ------------------------------------------------------------ environment
ENV=production
APP_NAME=BDE & Sales Portal
TIMEZONE=Asia/Kolkata

# --------------------------------------------------------------- database
# Least-privilege role that owns only its own database (not `postgres`).
# URL-encode the password if it contains @ : / # % or spaces.
DATABASE_URL=postgresql+psycopg2://bde_portal:<url-encoded-password>@localhost:5432/bde_portal
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------- auth/sessions
# 48+ random characters. Generate with:
#   backend\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<generate-a-long-random-value>
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=120
# HTTPS only. Host-only cookie (COOKIE_DOMAIN blank) is right for one origin.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# Must NOT be set in production. Create the first account with:
#   python -m app.seeds.bootstrap_admin --email <owner@company> --name "<Name>"
# SEED_PASSWORD=

# ------------------------------------------------------------ HTTP / proxy
# The exact public origin, https only, no trailing slash, no wildcard.
CORS_ORIGINS=https://portal.example.com
CORS_ORIGIN_REGEX=
# Caddy runs on the same machine; only it may set X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1
DOCS_ENABLED=false

# ---------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_FORMAT=json
SLOW_REQUEST_MS=1500

# ---------------------------------------------------------------- SAP data
# Absolute server-side path to the SAP workbook the backend watches (for
# example a OneDrive-synced folder on this machine). The service account must
# be able to read it. Leave blank and use Super Admin > Upload SAP file instead
# if the workbook is not on the server.
SAP_DATA_FILE=
SAP_AUTO_SYNC=true
SAP_SYNC_INTERVAL_SECONDS=30

# --------------------------------------------------------- feedback alerts
FEEDBACK_RATING_SCALE_MAX=5
FEEDBACK_ALERT_THRESHOLD=3.0
FEEDBACK_ALERT_MIN_RESPONSES=5
FEEDBACK_ALERT_WINDOW_DAYS=30
# Quote it: the URL contains a # fragment.
GOOGLE_REVIEW_URL=

# Google Form feedback sync (optional). 32+ random characters when used.
GOOGLE_SYNC_SECRET=
GOOGLE_SYNC_URL=

# --------------------------------------------------------------- assistant
# Optional. Both a key and CHAT_ENABLED=true are needed.
GROQ_API_KEY=
CHAT_ENABLED=false
GROQ_MODEL=llama-3.3-70b-versatile
