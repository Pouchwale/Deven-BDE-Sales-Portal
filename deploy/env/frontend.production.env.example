# BDE & Sales Portal - frontend production settings.
#
# Copy to frontend\.env.production.local on the production host (or set these
# as environment variables for the build and the service). Nothing here is
# secret. Values are read by `next build` - rebuild after changing them.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Where the Next server forwards /api/* if a request reaches it. Behind Caddy,
# /api/* goes straight to uvicorn, so this is a fallback for `next start`
# without the proxy (and for health checks on 127.0.0.1:3000).
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# NOT needed: the browser calls /api on the portal's own origin. Setting it
# would make the browser call a different origin (needs CORS, and is added to
# the Content-Security-Policy at build time).
# NEXT_PUBLIC_API_URL=
