# Copy to sap-uploader.env (same folder, git-ignored) and fill in.

# The live portal: the backend serves the pages and /api. (The old frontend
# address only redirects here.)
PORTAL_URL=https://deven-bde-sales-portal-backend.onrender.com

# The Super Admin sign-in on the live portal (SUPER_ADMIN_USERNAME / _PASSWORD
# on the Render backend). Only a Super Admin may import SAP files.
PORTAL_USERNAME=admin
PORTAL_PASSWORD=

# The SAP workbook on this PC that refreshes every day.
SAP_FILE=C:\Users\deven\OneDrive\Desktop\BDE and SALES PORTAL\BDE & SALES PORTAL SAP DATA.xlsm

# How often --watch checks the file for changes.
CHECK_MINUTES=5
