# Copy to sap-uploader.env (same folder, git-ignored) and fill in -
# or let set-sap-push-secret.ps1 write it for you.

# The live portal.
PORTAL_URL=https://deven-bde-sales-portal-backend.onrender.com

# Preferred: no password at all. Run set-sap-push-secret.ps1 once; the
# uploader then signs each push with that secret (stored encrypted for this
# Windows account) and these two lines are not needed.
# Fallback only: a Super Admin sign-in on the live portal.
# PORTAL_USERNAME=admin
# PORTAL_PASSWORD=

# The SAP workbook on this PC that refreshes every day.
SAP_FILE=C:\Users\deven\OneDrive\Desktop\GP3\BDE & SALES PORTAL SAP DATA.xlsm

# How often --watch checks the file for changes.
CHECK_MINUTES=5
