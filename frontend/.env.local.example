# Copy to .env.local for local development. Nothing here is secret.

# Where the Next server forwards /api/* (and /health). Server-side only - the
# browser always calls the portal's own origin, so the session cookie stays
# first-party and no CORS is needed. Rewrites are baked in at `next build`, so
# set this before building a production bundle.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Leave unset. Only for the unusual setup where the browser must call a
# backend on a DIFFERENT origin (it then also needs CORS on the backend and is
# added to the Content-Security-Policy connect-src at build time).
# NEXT_PUBLIC_API_URL=https://api.example.com
